# Postgres connection string from Supabase: Project settings -> Database -> Connection string (URI, "Transaction pooler")
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-north-1.pooler.supabase.com:6543/postgres
# Same long random string as WORKER_TOKEN in the web app
WORKER_TOKEN=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_WRITER=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
# Supabase Storage for audio and video (Project settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Optional: Azure AI Speech for the human-sounding podcast voices
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=northeurope
