# Copy this file to worker/.env for running on your own computer.
# Change "postgres" after password= to the password you chose when installing PostgreSQL.
DATABASE_URL=host=localhost port=5432 user=postgres password=postgres dbname=fu
WORKER_TOKEN=local-dev-token
PUBLIC_BASE_URL=http://localhost:8000
# demo = free, no key. For real AI: AI_PROVIDER=gemini and GEMINI_API_KEY=your-key
AI_PROVIDER=demo
GEMINI_API_KEY=
