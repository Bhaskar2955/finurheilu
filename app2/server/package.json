{
  "name": "finurheilu-server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "setup:appwrite": "tsx src/setup-appwrite.ts",
    "sync": "tsx src/sync.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "node-appwrite": "31.0.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.17.6",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "engines": { "node": ">=20" }
}
