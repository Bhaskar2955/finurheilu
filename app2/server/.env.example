# Copy to app2/server/.env

# --- Appwrite (free cloud plan). See app2/README.md, "Set up Appwrite". ---
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
# Server API key with scopes: databases.read, databases.write, tables.read, tables.write, rows.read, rows.write
APPWRITE_API_KEY=your-secret-api-key
APPWRITE_DATABASE_ID=finurheilu

# --- Liiga data ---
# auto = liiga.fi, then the copy in Appwrite, then built-in sample.
# appwrite = only the copy stored by `npm run sync`.  sample = always sample data.
DATA_MODE=auto
DATA_TTL_MINUTES=10
LIIGA_API_BASE=https://liiga.fi/api/v2

# --- Optional real AI for summaries (free key from aistudio.google.com). Empty = demo writer. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=4000
